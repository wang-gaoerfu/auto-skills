{
  "mcpServers": {
    "filesystem": {
      "command": "node",
      "args": ["D:/my_project/auto-skills/node_modules/@modelcontextprotocol/server-filesystem/dist/index.js", "D:/my_project/auto-skills"]
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"]
    },
    "zai-mcp-server": {
      "command": "npx",
      "args": ["-y", "@z_ai/mcp-server"],
      "env": {
        "Z_AI_API_KEY": "YOUR_API_KEY_HERE"
      }
    },
    "web-search-prime": {
      "transport": {
        "type": "http",
        "url": "https://open.bigmodel.cn/api/mcp/web_search_prime/mcp",
        "headers": {
          "Authorization": "Bearer YOUR_API_KEY_HERE"
        }
      }
    },
    "web-reader": {
      "transport": {
        "type": "http",
        "url": "https://open.bigmodel.cn/api/mcp/web_reader/mcp",
        "headers": {
          "Authorization": "Bearer YOUR_API_KEY_HERE"
        }
      }
    },
    "zread": {
      "transport": {
        "type": "http",
        "url": "https://open.bigmodel.cn/api/mcp/zread/mcp",
        "headers": {
          "Authorization": "Bearer YOUR_API_KEY_HERE"
        }
      }
    }
  }
}
