{
  // ========================================
  // 技能元数据配置文件
  // ========================================
  // 这是 Claude Code 技能的配置文件，定义了技能的基本信息
  // 当用户调用此技能时，Claude 会读取此文件

  // ----------------------------------------
  // 技能名称（必需）
  // ----------------------------------------
  // 规则：
  // 1. 使用 kebab-case 格式（小写字母和连字符）
  // 2. 不能包含空格或特殊字符
  // 3. 不要与内置命令冲突
  //
  // 示例：code-review, git-helper, file-ops
  "name": "basic-skill",

  // ----------------------------------------
  // 技能显示名称（可选）
  // ----------------------------------------
  // 用于在帮助信息中展示，可以使用空格
  //
  // 示例：Code Reviewer, Git Operations Helper
  "displayName": "Basic Skill Template",

  // ----------------------------------------
  // 技能描述（必需）
  // ----------------------------------------
  // 简短描述这个技能做什么，帮助用户了解功能
  // 建议不超过 100 个字符
  //
  // 示例：Performs a comprehensive code review
  "description": "简短描述这个技能的功能和用途",

  // ----------------------------------------
  // 版本号（必需）
  // ----------------------------------------
  // 使用语义化版本号格式：主版本.次版本.修订号
  //
  // 版本规则：
  // - 主版本：不兼容的 API 修改时递增
  // - 次版本：向下兼容的功能性新增时递增
  // - 修订号：向下兼容的问题修正时递增
  //
  // 示例：
  // - 1.0.0 - 初始发布
  // - 1.1.0 - 添加新功能
  // - 1.1.1 - 修复 bug
  // - 2.0.0 - 重大更新，不兼容旧版本
  "version": "1.0.0",

  // ----------------------------------------
  // 作者信息（可选）
  // ----------------------------------------
  // 记录技能的作者
  "author": "Your Name <your.email@example.com>",

  // ----------------------------------------
  // 参数定义（可选但推荐）
  // ----------------------------------------
  // 定义用户可以传递给技能的参数
  // 如果不需要参数，可以省略此字段
  "parameters": {
    // ----------------------------------------
    // 参数类型
    // ----------------------------------------
    // 固定为 "object"，表示这是一个参数对象
    "type": "object",

    // ----------------------------------------
    // 参数列表
    // ----------------------------------------
    // 定义每个参数的名称、类型、描述等
    "properties": {
      // ----------------------------------------
      // 示例参数：mode
      // ----------------------------------------
      // 这是一个字符串类型参数，有多个可选值
      "mode": {
        "type": "string",
        "enum": ["fast", "detailed", "auto"],
        "description": "操作模式：fast=快速, detailed=详细, auto=自动"
      },

      // ----------------------------------------
      // 示例参数：target
      // ----------------------------------------
      // 这是一个字符串类型参数，用于指定目标
      "target": {
        "type": "string",
        "description": "目标文件或路径"
      },

      // ----------------------------------------
      // 示例参数：verbose
      // ----------------------------------------
      // 这是一个布尔类型参数，用于控制输出详细程度
      "verbose": {
        "type": "boolean",
        "description": "是否显示详细输出，默认为 false",
        "default": false
      },

      // ----------------------------------------
      // 示例参数：count
      // ----------------------------------------
      // 这是一个数字类型参数，用于指定数量
      "count": {
        "type": "number",
        "description": "处理数量，默认为 10",
        "default": 10
      },

      // ----------------------------------------
      // 添加更多参数...
      // ----------------------------------------
    },

    // ----------------------------------------
    // 必需参数列表
    // ----------------------------------------
    // 指定哪些参数是必须提供的
    // 如果用户没有提供这些参数，Claude 会提示用户输入
    //
    // 示例：
    // - ["mode"] - mode 是必需的
    // - ["mode", "target"] - mode 和 target 都是必需的
    // - [] - 没有必需参数
    "required": ["mode"]
  }
}
