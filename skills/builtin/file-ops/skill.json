{
  // ========================================
  // 技能元数据配置文件
  // ========================================
  // 说明：这个文件定义了技能的基本信息和参数结构
  // 当用户调用 /file-ops 命令时，Claude 会读取此文件

  // 技能名称（必需）
  // 规则：使用 kebab-case 格式，小写字母和连字符
  "name": "file-ops",

  // 技能显示名称（可选）
  // 用于在帮助信息中展示
  "displayName": "File Operations Helper",

  // 技能描述（必需）
  // 简短说明这个技能做什么
  "description": "文件操作助手，支持文件搜索、读取、编辑等常用操作",

  // 版本号（必需）
  // 使用语义化版本号：主版本.次版本.修订号
  // - 主版本：不兼容的 API 修改
  // - 次版本：向下兼容的功能性新增
  // - 修订号：向下兼容的问题修正
  "version": "1.0.0",

  // 作者信息（可选）
  "author": "Auto-Skills Team",

  // 参数定义（可选但推荐）
  // 定义用户可以传递给技能的参数
  "parameters": {
    // 参数类型
    "type": "object",

    // 参数列表
    "properties": {
      // action 参数：指定要执行的操作类型
      "action": {
        "type": "string",
        // 可选值枚举
        "enum": ["search", "read", "edit", "create", "delete", "rename", "list"],
        "description": "操作类型：search=搜索文件, read=读取文件, edit=编辑文件, create=创建文件, delete=删除文件, rename=重命名文件, list=列出目录"
      },

      // path 参数：指定文件路径
      "path": {
        "type": "string",
        "description": "文件或目录路径，支持相对路径和绝对路径"
      },

      // pattern 参数：搜索模式（用于 search 操作）
      "pattern": {
        "type": "string",
        "description": "搜索模式，支持文件名通配符或内容关键字"
      },

      // content 参数：文件内容（用于 create/edit 操作）
      "content": {
        "type": "string",
        "description": "要写入文件的内容"
      },

      // recursive 参数：是否递归（用于 search/list 操作）
      "recursive": {
        "type": "boolean",
        "description": "是否递归处理子目录，默认为 false"
      },

      // dryRun 参数：预演模式
      "dryRun": {
        "type": "boolean",
        "description": "只显示将要执行的操作，不实际执行，默认为 false"
      }
    },

    // 必需参数列表
    // 指定哪些参数是必须提供的
    "required": ["action"]
  }
}
