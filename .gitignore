# .claude/skills 是符号链接，源文件已在 skills/ 下追踪
.claude/skills/

# MCP 配置（包含 API 密钥）
.claude/mcp.json
.claude/settings.local.json
.claude/*.local.json

# SQLite 数据库
data/*.db
data/*.db-journal

# Cookies（包含敏感信息）
data/cookies.txt

# Node modules
node_modules/

# Python 虚拟环境
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# IDE
.vscode/
.idea/

# 环境变量（包含 API 密钥）
.env
.env.local
.env.*.local
nul

# 知识库大文件
knowledge/*.pdf
knowledge/
