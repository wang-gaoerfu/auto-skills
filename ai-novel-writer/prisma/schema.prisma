// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 用户模型
// ============================================
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  role          String    @default("USER") // USER, ADMIN
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  membership    Membership?
  projects      Project[]
  knowledge     KnowledgeEntry[]
  usageLogs     UsageLog[]

  @@index([email])
  @@map("users")
}

// ============================================
// 会员模型
// ============================================
model Membership {
  id              String    @id @default(cuid())
  userId          String    @unique
  plan            String    @default("FREE") // FREE, VIP, PRO
  status          String    @default("APPROVED") // PENDING, APPROVED, REJECTED, EXPIRED
  expiresAt       DateTime?
  appliedAt       DateTime  @default(now())
  approvedAt      DateTime?
  approvedBy      String?
  redemptionCodeId String?
  rejectedAt      DateTime?
  rejectReason    String?

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  redemptionCode  RedemptionCode?    @relation(fields: [redemptionCodeId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("memberships")
}

// ============================================
// 兑换码模型
// ============================================
model RedemptionCode {
  id            String   @id @default(cuid())
  code          String   @unique // VIP-2024-XXXXXX
  plan          String            // VIP, PRO
  duration      Int               // 有效期（天）
  maxUses       Int      @default(1) // 最大使用次数
  usedCount     Int      @default(0) // 已使用次数
  status        String   @default("ACTIVE") // ACTIVE, DISABLED, EXPIRED
  expiresAt     DateTime? // 兑换码过期时间
  createdBy     String?  // 创建人ID
  createdAt     DateTime @default(now())

  memberships   Membership[]

  @@index([code])
  @@index([status])
  @@index([plan])
  @@map("redemption_codes")
}

// ============================================
// 项目模型
// ============================================
model Project {
  id            String    @id @default(cuid())
  userId        String
  title         String
  description   String?
  coverImage    String?
  outline       Json?
  settings      Json?
  genre         String?// 小说题材
  novelLength   String?   // 小说长度: micro, short, medium, long
  status        String    @default("draft") // draft: 草稿, writing: 写作中, completed: 已完结
  targetWords   Int?      // 目标字数（可选）
  targetChapters Int?     // 目标章节数（可选）
  completedAt   DateTime? // 完结时间
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters      Chapter[]
  knowledge     KnowledgeEntry[]

  @@index([userId])
  @@index([status])
  @@map("projects")
}

// ============================================
// 章节模型
// ============================================
model Chapter {
  id            String    @id @default(cuid())
  projectId     String
  title         String
  content       String    @default("")
  order         Int
  wordCount     Int       @default(0)
  vectorId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([order])
  @@map("chapters")
}

// ============================================
// 知识库条目模型
// ============================================
model KnowledgeEntry {
  id            String    @id @default(cuid())
  userId        String
  projectId     String?
  entryType     String    // character, world, plot, scene, dialogue
  title         String
  content       Json
  tags          String[]
  vectorId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([entryType])
  @@map("knowledge_entries")
}

// ============================================
// 使用记录模型（配额控制）
// ============================================
model UsageLog {
  id            String    @id @default(cuid())
  userId        String
  actionType    String    // generate, optimize, etc.
  model         String    // 使用的AI模型
  tokensUsed    Int
  wordCount     Int
  cost          Float     // 成本（分）
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("usage_logs")
}
