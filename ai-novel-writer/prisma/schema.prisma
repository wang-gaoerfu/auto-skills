// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 用户模型
// ============================================
model User {
  id              String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  role          String    @default("USER") // USER, ADMIN, SUPER_ADMIN
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 小说系统关联
  membership        Membership?
  projects          Project[]
  knowledge         KnowledgeEntry[]
  usageLogs         UsageLog[]
  autoCreateTasks AutoCreateTask[]

  // 剧本系统关联
  scriptMembership   ScriptMembership?
  scriptProjects   ScriptProject[]
  scriptCostLogs   ScriptCostLog[]
  scriptExports      ScriptExport[]

  @@index([email])
  @@map("users")
}

// ============================================
// 会员模型
// ============================================
model Membership {
  id              String    @id @default(cuid())
  userId          String    @unique
  plan            String    @default("FREE") // FREE, VIP, PRO
  status          String    @default("APPROVED") // PENDING, APPROVED, REJECTED, EXPIRED
  expiresAt       DateTime?
  appliedAt       DateTime  @default(now())
  approvedAt      DateTime?
  approvedBy      String?
  redemptionCodeId String?
  rejectedAt      DateTime?
  rejectReason    String?

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  redemptionCode  RedemptionCode?    @relation(fields: [redemptionCodeId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("memberships")
}

// ============================================
// 兑换码模型
// ============================================
model RedemptionCode {
  id            String   @id @default(cuid())
  code          String   @unique // VIP-2024-XXXXXX
  plan          String            // VIP, PRO
  duration      Int               // 有效期（天）
  maxUses       Int      @default(1) // 最大使用次数
  usedCount     Int      @default(0) // 已使用次数
  status        String   @default("ACTIVE") // ACTIVE, DISABLED, EXPIRED
  expiresAt     DateTime? // 兑换码过期时间
  createdBy     String?  // 创建人ID
  createdAt     DateTime @default(now())

  memberships   Membership[]

  @@index([code])
  @@index([status])
  @@index([plan])
  @@map("redemption_codes")
}

// ============================================
// 项目模型
// ============================================
model Project {
  id            String    @id @default(cuid())
  userId        String
  title         String
  description   String?
  coverImage    String?
  outline       Json?
  settings      Json?
  genre         String?// 小说题材
  novelLength   String?   // 小说长度: micro, short, medium, long
  status        String    @default("draft") // draft: 草稿, writing: 写作中, completed: 已完结
  targetWords   Int?      // 目标字数（可选）
  targetChapters Int?     // 目标章节数（可选）
  completedAt   DateTime? // 完结时间
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters          Chapter[]
  knowledge         KnowledgeEntry[]
  autoCreateTasks AutoCreateTask[]

  // 剧本系统关联（作为来源项目）
  scriptProjects   ScriptProject[]

  @@index([userId])
  @@index([status])
  @@map("projects")
}

// ============================================
// 章节模型
// ============================================
model Chapter {
  id            String    @id @default(cuid())
  projectId     String
  title         String
  content       String    @default("")
  order         Int
  wordCount     Int       @default(0)
  vectorId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([order])
  @@map("chapters")
}

// ============================================
// 知识库条目模型
// ============================================
model KnowledgeEntry {
  id            String    @id @default(cuid())
  userId        String
  projectId     String?
  entryType     String    // character, world, plot, scene, dialogue
  title         String
  content       Json
  tags          String[]
  vectorId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([entryType])
  @@map("knowledge_entries")
}

// ============================================
// 使用记录模型（配额控制）
// ============================================
model UsageLog {
  id            String    @id @default(cuid())
  userId        String
  actionType    String    // generate, optimize, etc.
  model         String    // 使用的AI模型
  tokensUsed    Int
  wordCount     Int
  cost          Float     // 成本（分）
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("usage_logs")
}

// ============================================
// 自动创作任务模型（断点续传）
// ============================================
model AutoCreateTask {
  id              String    @id @default(cuid())
  userId          String
  projectId       String

  // 任务状态
  status          String    @default("pending") // pending, running, paused, completed, failed, cancelled
  currentStage    String    @default("")        // creating_project, generating_knowledge, generating_chapters, completing
  progress        Json      @default("{}")      // { currentChapter: 1, totalChapters: 5, knowledgeGenerated: ["character", "world"] }

  // 配置信息
  title           String
  description     String?
  genre           String
  novelLength     String
  targetChapters  Int       @default(3)

  // 执行结果
  generatedChapters Int     @default(0)
  totalWordCount    Int     @default(0)
  tokensUsed        Int     @default(0)
  errorMessage      String?

  // 时间戳
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@map("auto_create_tasks")
}

// ============================================
// 剧本系统 - 剧本项目模型
// ============================================
model ScriptProject {
  id                  String    @id @default(cuid())
  userId              String
  title               String
  description         String?
  coverImage          String?
  sourceType          String    @default("ORIGINAL") // OWN_PROJECT, EXTERNAL, ORIGINAL
  sourceProjectId     String?   // 如果来自自有小说项目
  sourceNovelTitle    String?   // 来源小说名称
  genre               String?
  status              String    @default("draft") // draft, preparing, generating, paused, completed, error, retrying
  subStatus           String?   // chapter_splitting, character_extracting, scene_extracting, storyboard_generating, finalizing
  progress            Int       @default(0) // 0-100
  generationLock      String?   // 并发锁（任务ID或UUID）
  lockAcquiredAt      DateTime?
  settings            Json?     // 生成配置
  totalTokens         Int       @default(0)
  totalShots          Int       @default(0)
  totalDuration       Int       @default(0) // 总时长（秒）
  totalScenes         Int       @default(0)
  lastExportAt        DateTime?
  exportCount         Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceProject       Project?          @relation(fields: [sourceProjectId], references: [id], onDelete: SetNull)
  sources             ScriptSource[]
  characters          ScriptCharacter[]
  scenes              ScriptScene[]
  generationTasks     ScriptGenerationTask[]
  exports             ScriptExport[]
  costLogs            ScriptCostLog[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("script_projects")
}

// ============================================
// 剧本系统 - 原始素材模型
// ============================================
model ScriptSource {
  id                String    @id @default(cuid())
  scriptProjectId   String
  chapterTitle      String
  content           String    @db.Text
  wordCount         Int       @default(0)
  sourceChapterId   String?   // 原始章节ID（可追溯到小说章节）
  order             Int
  createdAt         DateTime  @default(now())

  scriptProject     ScriptProject  @relation(fields: [scriptProjectId], references: [id], onDelete: Cascade)
  scenes            ScriptScene[]

  @@index([scriptProjectId])
  @@index([order])
  @@map("script_sources")
}

// ============================================
// 剧本系统 - 角色模型
// ============================================
model ScriptCharacter {
  id                  String    @id @default(cuid())
  scriptProjectId     String
  name                String
  role                String?   // protagonist, supporting, minor
  gender              String?   // male, female, other
  ageRange            String?   // "20-25"
  description         String?
  appearance          Json?     // 外观描述：发型、服装、特征、visualPrompt 等
  personality         String?
  relationships       Json?     // 与其他角色关系
  avatarImage         String?   // 角色头像/参考图
  firstAppearChapter  Int?      // 首次出场章节
  shotCount           Int       @default(0) // 出场镜头数
  vectorId            String?   // 向量检索用
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  scriptProject       ScriptProject  @relation(fields: [scriptProjectId], references: [id], onDelete: Cascade)

  @@index([scriptProjectId])
  @@map("script_characters")
}

// ============================================
// 剧本系统 - 场景模型
// ============================================
model ScriptScene {
  id                  String    @id @default(cuid())
  scriptProjectId     String
  sourceId            String?   // 关联原始素材
  sceneNumber         Int
  title               String
  timeOfDay           String?   // 日/夜/黄昏/黎明
  location            String?   // 内/外
  description         String?   @db.Text
  mood                String?   // 场景氛围
  weather             String?   // 晴/雨/雪/阴
  lighting            String?   // 明亮/昏暗/霓虹/自然
  visualPrompt        String?   @db.Text // 环境视觉描述（AI生图用）
  referenceImage      String?   // 场景参考图
  soundDesign         Json?     // 音效设计
  shotCount           Int       @default(0)
  totalDuration       Int       @default(0) // 场景时长（秒）
  order               Int
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  scriptProject       ScriptProject  @relation(fields: [scriptProjectId], references: [id], onDelete: Cascade)
  source              ScriptSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  shots               ScriptShot[]

  @@index([scriptProjectId])
  @@index([order])
  @@map("script_scenes")
}

// ============================================
// 剧本系统 - 镜头模型
// ============================================
model ScriptShot {
  id                  String    @id @default(cuid())
  sceneId             String
  shotNumber          String    // "1-1", "1-2" 等
  shotType            String    // 特写/近景/中景/全景/远景
  angle               String?   // 平视/仰视/俯视/斜角
  status              String    @default("draft") // draft, generated, regenerating, failed
  visual              Json?     // 画面描述
  imagePrompt         String?   @db.Text // 独立存储图片提示词
  generatedImageUrl   String?   // 生成的图片URL
  audio               Json?     // 音频描述
  camera              Json?     // 镜头运动
  characterIds        String[]  // 出场角色ID列表
  dialogueCount       Int       @default(0)
  duration            Int       @default(3) // 秒数
  regenerateCount     Int       @default(0)
  isEdited            Boolean   @default(false)
  order               Int
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  scene               ScriptScene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([sceneId])
  @@index([order])
  @@index([status])
  @@map("script_shots")
}

// ============================================
// 剧本系统 - 会员模型（独立于小说会员）
// ============================================
model ScriptMembership {
  id                  String    @id @default(cuid())
  userId              String    @unique
  plan                String    @default("FREE") // FREE, ENTRY, VIP, PRO
  status              String    @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  expiresAt           DateTime?
  projectCount        Int       @default(0)
  dailyGenerations    Int       @default(0)
  monthlyGenerations  Int       @default(0)
  lastGenerationDate  DateTime?
  redemptionCodeId    String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  redemptionCode      ScriptRedemptionCode?  @relation(fields: [redemptionCodeId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("script_memberships")
}

// ============================================
// 剧本系统 - 生成任务模型
// ============================================
model ScriptGenerationTask {
  id                  String    @id @default(cuid())
  scriptProjectId     String
  chapterOrder        Int
  status              String    @default("pending") // pending, processing, completed, failed, cancelled
  progress            Int       @default(0) // 0-100
  retryCount          Int       @default(0)
  checkpoint          Json?     // 断点数据
  error               String?
  errorMessage        String?
  tokens              Int       @default(0)
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())

  scriptProject       ScriptProject  @relation(fields: [scriptProjectId], references: [id], onDelete: Cascade)

  @@index([scriptProjectId])
  @@index([status])
  @@index([createdAt])
  @@map("script_generation_tasks")
}

// ============================================
// 剧本系统 - 导出记录模型
// ============================================
model ScriptExport {
  id                  String    @id @default(cuid())
  scriptProjectId     String
  userId              String
  format              String    // json, md, pdf, excel
  watermark           String?
  fileSize            Int       @default(0)
  shotCount           Int       @default(0)
  downloadUrl         String?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())

  scriptProject       ScriptProject  @relation(fields: [scriptProjectId], references: [id], onDelete: Cascade)
  user                User           @relation(fields: [userId], references: [id])

  @@index([scriptProjectId])
  @@index([userId])
  @@index([createdAt])
  @@map("script_exports")
}

// ============================================
// 剧本系统 - 独立兑换码模型
// ============================================
model ScriptRedemptionCode {
  id                  String   @id @default(cuid())
  code                String   @unique // SCRIPT-VIP-2024-XXXXXX
  plan                String            // VIP, PRO
  duration            Int               // 有效期（天）
  maxUses             Int      @default(1)
  usedCount           Int      @default(0)
  status              String   @default("ACTIVE") // ACTIVE, DISABLED, EXPIRED
  expiresAt           DateTime?
  createdBy           String?
  createdAt           DateTime @default(now())

  scriptMemberships   ScriptMembership[]

  @@index([code])
  @@index([status])
  @@index([plan])
  @@map("script_redemption_codes")
}

// ============================================
// 剧本系统 - 成本日志模型
// ============================================
model ScriptCostLog {
  id                  String    @id @default(cuid())
  userId              String
  projectId           String
  operation           String    // chapter_split, character_extract, storyboard_generate, ...
  model               String    // deepseek-chat, glm-4-flash
  inputTokens         Int       @default(0)
  outputTokens        Int       @default(0)
  cost                Float     @default(0) // 元
  cached              Boolean   @default(false)
  createdAt           DateTime  @default(now())

  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  scriptProject       ScriptProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([createdAt])
  @@map("script_cost_logs")
}

// ============================================
// 剧本系统 - 提示词版本模型
// ============================================
model PromptVersion {
  id                  String    @id @default(cuid())
  promptKey           String    // "CHAPTER_SPLIT_PROMPT"
  version             String    // "1.0.0"
  content             Json      // 完整提示词结构
  model               String    // 目标模型 "deepseek-chat"
  isActive            Boolean   @default(true)
  performance         Json?     // { avgTokens: 5000, successRate: 0.98, avgLatency: 3.5 }
  changelog           String?   // 变更说明
  createdAt           DateTime  @default(now())
  createdBy           String?

  @@unique([promptKey, version])
  @@index([promptKey, isActive])
  @@map("prompt_versions")
}

// ============================================
// 剧本系统 - 系统配置模型
// ============================================
model ScriptSystemConfig {
  id                    String    @id @default("system")
  dailyBudgetLimit      Float     @default(500)      // 日预算上限 ¥500
  monthlyBudgetLimit    Float     @default(10000)    // 月预算上限 ¥10000
  userDailyCostCap      Float     @default(10)       // 单用户日成本上限 ¥10
  projectCostCap        Float     @default(50)       // 单项目成本上限 ¥50
  alertThresholdPercent Int      @default(80)       // 告警阈值 80%
  generationPaused      Boolean   @default(false)    // 生成暂停标志
  pausedReason          String?                      // 暂停原因
  updatedAt             DateTime  @updatedAt

  @@map("script_system_configs")
}
