# ============================================
# Leader-Spark 后端环境变量配置
# ============================================

# 应用配置
APP_NAME=Leader-Spark
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars

# ============================================
# 数据库配置
# ============================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=leader_spark
DB_USER=leader_spark
DB_PASSWORD=your_secure_password_here

# 数据库连接池配置
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============================================
# Qdrant 向量数据库配置
# ============================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=leader_spark_kb

# ============================================
# DeepSeek API 配置
# ============================================
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_EMBEDDING_MODEL=deepseek-embedding

# 模型参数默认值
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2000
DEFAULT_TOP_P=0.9
DEFAULT_FREQUENCY_PENALTY=0.0
DEFAULT_PRESENCE_PENALTY=0.0

# Token 定价（用于费用估算，单位：美元/1K tokens）
# DeepSeek 定价参考：https://www.deepseek.com/pricing
DEEPSEEK_CHAT_INPUT_PRICE=0.001
DEEPSEEK_CHAT_OUTPUT_PRICE=0.002
DEEPSEEK_EMBEDDING_PRICE=0.0001

# ============================================
# 邮件配置
# ============================================
MAIL_SERVER=smtp.163.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USE_TLS=false
MAIL_USERNAME=wangTest321@163.com
MAIL_PASSWORD=WVuUuxnuBBiWqi2x
MAIL_DEFAULT_SENDER=Leader-Spark平台 <wangTest321@163.com>
MAIL_FROM_NAME=Leader-Spark平台

# 验证码配置
VERIFICATION_CODE_LENGTH=6
VERIFICATION_CODE_EXPIRE_MINUTES=10
VERIFICATION_CODE_RESEND_INTERVAL=60

# ============================================
# JWT 配置
# ============================================
JWT_SECRET_KEY=your-jwt-secret-key-change-this-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24小时
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ============================================
# Redis 配置（可选，用于缓存）
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================
# 文件上传配置
# ============================================
# 允许的文件类型
ALLOWED_FILE_EXTENSIONS=docx,pdf,txt,md

# 文件大小限制（字节）
MAX_FILE_SIZE=52428800  # 50MB

# 上传目录
UPLOAD_DIR=/app/uploads
CHUNK_DIR=/app/uploads/chunks

# ============================================
# 安全配置
# ============================================
# 登录失败锁定配置
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# 密码强度要求
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# CORS 配置
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# 日志文件路径
LOG_FILE=/app/logs/app.log
ACCESS_LOG_FILE=/app/logs/access.log

# ============================================
# 向量检索配置
# ============================================
# 向量维度（DeepSeek embedding 维度）
EMBEDDING_DIMENSION=1536

# 文本分块配置
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 检索配置
DEFAULT_TOP_K=5  # 检索最相关的 K 个文档
SIMILARITY_THRESHOLD=0.7  # 相似度阈值

# ============================================
# AI 分类配置
# ============================================
# 自动分类使用的模型
CLASSIFICATION_MODEL=deepseek-chat

# 分类置信度阈值
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.6

# ============================================
# 文档处理配置
# ============================================
# 并发处理数量
MAX_CONCURRENT_PROCESSING=5

# 处理超时时间（秒）
DOCUMENT_PROCESSING_TIMEOUT=300

# ============================================
# 聊天配置
# ============================================
# 会话标题长度
SESSION_TITLE_MAX_LENGTH=100

# 默认会话标题（从第一条消息生成）
DEFAULT_SESSION_TITLE=新对话

# 最大上下文消息数
MAX_CONTEXT_MESSAGES=20

# ============================================
# 管理员配置
# ============================================
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin@9000

# ============================================
# 开发模式配置（仅开发环境）
# ============================================
# 开发模式配置
DEBUG=false
RELOAD=false

# 开发环境数据库（不使用 Docker）
# DB_HOST=localhost
# QDRANT_HOST=localhost
